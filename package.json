{
  "name": "prompt-studio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "app": "electron . --dev",
    "build": "vue-tsc -b && vite build",
    "dist": "vue-tsc -b && vite build && electron-builder --win --publish never",
    "release": "vue-tsc -b && vite build && electron-builder --win --publish always",
    "preview": "vite preview",
    "test": "node --import ./tests/resolve-ts.mjs --test --experimental-test-isolation=none tests/core.test.ts"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "~5.7.3",
    "vite": "^6.0.7",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "description": "千夏绘卷 Chinatsu Scroll — 提示词管理 / 翻译 / AI 生成 / ComfyUI 画框布局",
  "author": "水千夏",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.ctingball.promptstudio",
    "productName": "PromptStudio",
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json",
      "build/icon.ico"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "ChinatsuScroll-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "千夏绘卷",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "千夏绘卷 Chinatsu Scroll",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "CtingBall",
        "repo": "PromptStudio",
        "releaseType": "release"
      }
    ]
  }
}
